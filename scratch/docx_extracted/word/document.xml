" noSelect="false" noResize="false" noGrp="false"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="Picture 1"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill rotWithShape="true"><a:blip r:embed="rId2" cstate="print"><a:extLst><a:ext uri="{28A0092B-C50C-407E-A947-70E740481C1C}"><a14:useLocalDpi xmlns:a14="http://schemas.microsoft.com/office/drawing/2010/main" val="0"/></a:ext></a:extLst></a:blip><a:srcRect l="0" t="0" r="0" b="0"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="6309360" cy="9464040"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:br w:type="page"/></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style1"/><w:rPr></w:rPr></w:pPr><w:r><w:t>1. 🚜 Matériel agricole</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>1. SAME Frutteto 70 Natural</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>Tracteur spécialisé pour vergers et vignobles.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Démarrer selon le manuel, choisir une vitesse adaptée, atteler l’outil au relevage 3 points, régler la profondeur et travailler à vitesse régulière. Vérifier l’huile, le refroidissement et les pneus avant utilisation.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>2. Solis 26</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>Petit tracteur compact pour petites exploitations, cultures étroites et entretien.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Après les contrôles de sécurité, sélectionner le rapport adapté, engager le 4x4 si nécessaire et utiliser la prise de force uniquement au régime prévu pour l’outil. Il peut notamment servir au traitement et à l’entretien des cultures.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>3. Deutz-Fahr 5070 DF Keyline</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>Tracteur spécialisé et polyvalent pour différentes opérations agricoles.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Atteler l’outil, régler le relevage et la profondeur, choisir le rapport correspondant au travail puis avancer à vitesse constante. Ne jamais intervenir sur un outil entraîné par la prise de force lorsqu’il tourne.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>4. Antonio Carraro Tigre 3200</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>Tracteur compact pour espaces étroits, jardins et petites exploitations.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Contrôler les freins et la direction, démarrer sur terrain dégagé, choisir une vitesse lente dans les zones étroites et utiliser le rayon de braquage réduit pour manœuvrer entre les rangs.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:br w:type="page"/></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style1"/><w:rPr></w:rPr></w:pPr><w:r><w:t>2. 🚗 Véhicules</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>1. Fiat Panda</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>Voiture citadine polyvalente, adaptée aux déplacements quotidiens.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Régler le siège et les rétroviseurs, boucler la ceinture, démarrer et sélectionner le mode de conduite adapté. Respecter les limitations, la charge maximale et le programme d’entretien du constructeur.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>2. Fiat 500</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>Petite voiture emblématique et adaptée à la circulation urbaine.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Utiliser les commandes de conduite conformément au manuel, contrôler régulièrement pneus, freins, éclairage et niveaux, puis effectuer les révisions aux intervalles recommandés.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>3. Lancia Ypsilon</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>Citadine compacte et confortable.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Avant le départ, vérifier les voyants et la pression des pneus. Utiliser les aides à la conduite conformément au manuel et effectuer les entretiens prévus par le constructeur.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>4. Jeep Renegade</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>SUV compact utilisable en ville et sur certains chemins.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Pour les terrains difficiles, sélectionner le mode de conduite approprié lorsqu’il est disponible. Réduire la vitesse sur terrain accidenté et respecter les limites de remorquage et de charge.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:br w:type="page"/></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style1"/><w:rPr></w:rPr></w:pPr><w:r><w:t>3. 📱 Appareils électroniques</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>1. iPhone (Apple)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>Smartphone haut de gamme pour communication, photo, travail et loisirs.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Charger avec un adaptateur compatible, configurer le compte et les mises à jour, protéger l’appareil par un code et sauvegarder régulièrement les données.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>2. Samsung Galaxy</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>Smartphone Android très répandu.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Charger la batterie, configurer le compte Google/Samsung, installer les mises à jour et utiliser les réglages de sécurité. Éviter l’humidité et les températures extrêmes.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>3. Smartphone Xiaomi</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>Smartphone Android proposant de nombreux modèles à différents prix.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Installer les applications depuis les boutiques officielles, effectuer les mises à jour, activer un verrouillage sécurisé et sauvegarder les données importantes.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>4. iPad (Apple)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>Tablette tactile pour travail, études, dessin et divertissement.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Charger la tablette, configurer le compte, connecter les accessoires compatibles et utiliser les mises à jour. Nettoyer l’écran avec un chiffon doux sans liquide directement sur l’appareil.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:br w:type="page"/></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style1"/><w:rPr></w:rPr></w:pPr><w:r><w:t>4. 🏠 Équipements de maison</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>1. Réfrigérateur Smeg</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>Réfrigérateur au design italien, destiné à la conservation des aliments.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Installer sur une surface stable et ventilée, régler la température recommandée, éviter de bloquer les ouvertures d’air et nettoyer régulièrement les joints et surfaces.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>2. Machine à café Smeg / La Pavoni</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>Machine destinée à préparer espresso et boissons à base de café.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Remplir le réservoir, utiliser du café adapté, lancer le cycle selon le modèle, puis nettoyer le groupe, la buse vapeur et le bac après utilisation. Suivre le manuel pour le détartrage.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>3. Lave-linge Smeg</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>Appareil pour laver le linge.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Trier le linge, respecter la charge maximale, mettre la quantité correcte de lessive, choisir le programme adapté et nettoyer périodiquement le filtre et le bac à produits.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>4. Four de cuisine italien</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>Four pour cuisson, pâtisserie et rôtissage.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Préchauffer selon la recette, choisir le mode de cuisson, placer le plat correctement et surveiller la cuisson. Laisser refroidir avant le nettoyage et ne jamais obstruer les aérations.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:br w:type="page"/></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style1"/><w:rPr></w:rPr></w:pPr><w:r><w:t>5. 👕 Vêtements et accessoires</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>1. Sac à main en cuir italien</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>Accessoire de mode et de transport personnel.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Éviter l’eau et les sources de chaleur, conserver dans une housse lorsqu’il n’est pas utilisé et nettoyer le cuir avec un produit adapté à sa finition.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>2. Chaussures en cuir italiennes</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>Chaussures réputées pour leur finition et leur confort.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Utiliser des embauchoirs si possible, brosser après usage, appliquer un produit d’entretien adapté au cuir et laisser sécher naturellement.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>3. Costume italien</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>Tenue élégante utilisée notamment pour les occasions professionnelles et formelles.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Porter avec une chemise et des chaussures adaptées, suspendre sur un cintre large et privilégier le nettoyage professionnel lorsque l’étiquette l’exige.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>4. Lunettes de soleil italiennes</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>Accessoire de mode et de protection solaire.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Les porter selon leur usage prévu, nettoyer les verres avec une microfibre et les conserver dans un étui pour éviter rayures et chocs.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:br w:type="page"/></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style1"/><w:rPr></w:rPr></w:pPr><w:r><w:t>6. 🏗️ Matériel de construction</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>1. Excavatrice</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>Machine pour creuser, charger et déplacer des matériaux.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Effectuer l’inspection avant démarrage, vérifier les niveaux et les dispositifs de sécurité, stabiliser la machine, travailler à distance des personnes et utiliser le godet selon la capacité prévue.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>2. Chargeuse sur pneus</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>Machine destinée au chargement et au déplacement de matériaux.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Contrôler pneus, freins et système hydraulique, abaisser le godet pendant les déplacements lorsque nécessaire, charger sans dépasser la capacité et garder les personnes hors de la zone de travail.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>3. Grue de chantier</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>Machine utilisée pour lever et déplacer des charges lourdes.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Son utilisation doit être réservée à un opérateur formé. Vérifier la charge, le rayon de levage, les dispositifs de sécurité et l’état du matériel avant chaque opération. Ne jamais passer une charge au-dessus de personnes.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style2"/><w:rPr></w:rPr></w:pPr><w:r><w:t>4. Tractopelle</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Description : </w:t></w:r><w:r><w:t>Engin polyvalent pour creuser, charger et déplacer des matériaux.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:spacing w:after="140"/><w:rPr></w:rPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Mode d’emploi (résumé) : </w:t></w:r><w:r><w:t>Stabiliser les béquilles, utiliser le godet adapté, travailler avec une bonne visibilité et respecter les limites de charge. L’opérateur doit être formé et suivre le manuel de la machine.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style0"/><w:rPr></w:rPr></w:pPr><w:r><w:br w:type="page"/></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style1"/><w:rPr></w:rPr></w:pPr><w:r><w:t>Sources et précisions</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style48"/><w:rPr></w:rPr></w:pPr><w:r><w:t>Classement italien des tracteurs 2025 : Frutteto 70 Natural, Solis 26, Deutz-Fahr 5070 DF Keyline, New Holland T5.120, EK1-261, VST FieldTrac 927, New Holland T4.100 F, Antonio Carraro Tigre 3200, Fendt 211 F Vario et Antonio Carraro TGF 7800 figurent dans le Top 10 cité par des sources spécialisées italiennes.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style48"/><w:rPr></w:rPr></w:pPr><w:r><w:t>SAME : https://www.same-tractors.com/</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style48"/><w:rPr></w:rPr></w:pPr><w:r><w:t>Solis / Yanmar : https://www.yanmar.com/global/agri/tractor/br_solis26/</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style48"/><w:rPr></w:rPr></w:pPr><w:r><w:t>Antonio Carraro : https://www.antoniocarraro.it/</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style48"/><w:rPr></w:rPr></w:pPr><w:r><w:t>Smeg : https://www.smeg.com/</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style48"/><w:rPr></w:rPr></w:pPr><w:r><w:t>Pour les véhicules et appareils électroniques, les quatre exemples sont des illustrations de produits connus ; le document ne prétend pas établir un classement statistique de préférence des Italiens.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="style48"/><w:rPr></w:rPr></w:pPr><w:r><w:t>Les modes d’emploi sont des résumés généraux. Pour utiliser réellement une machine, il faut toujours consulter le manuel du modèle exact et respecter les règles de sécurité.</w:t></w:r></w:p><w:sectPr><w:footerReference w:type="default" r:id="rId3"/><w:pgSz w:w="12240" w:h="15840" w:orient="portrait"/><w:pgMar w:top="864" w:right="936" w:bottom="864" w:left="936" w:header="720" w:footer="720" w:gutter="0"/><w:cols w:space="720"></w:cols><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>